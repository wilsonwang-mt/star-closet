# 复制为 .env.local 后填写；.env.local 不进仓库。
# 不填时一句话改编与悬浮对话都只用规则，界面不另加提示（D48）。
ANTHROPIC_API_KEY=
# 悬浮对话（D56）用的模型，留空为 claude-opus-5-5（effort low）。没有 ANTHROPIC_API_KEY 时对话只用规则定位。
CHAT_MODEL=
# 悬浮对话默认用 Opus fast mode（价格为标准 2 倍）；填 standard 关掉。
CHAT_SPEED=
# Better Auth 会话签名密钥，至少 32 位随机字符串：openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Supabase Postgres 连接串（Project Settings → Database）。不填则用本地 PGlite。
# 应用运行走 transaction pooler（6543 端口）；建表迁移走 session 模式或 5432 端口。
DATABASE_URL=
DATABASE_MIGRATE_URL=
# 3D 形象生成服务：mock（默认，不访问外部网络，返回非本人示意人台）| tripo_fal（需要 FAL_KEY）| metaperson（需要下面两项 AVATARSDK_*）。缺 key 自动回落 mock。
AVATAR3D_PROVIDER=
FAL_KEY=
AVATAR3D_MAX_POLL_SECONDS=
# MetaPerson（Avatar SDK）：client id / secret 只在服务端换取访问令牌，secret 不发给浏览器。
AVATARSDK_CLIENT_ID=
AVATARSDK_CLIENT_SECRET=
# 导出文件下载主机白名单追加项（逗号分隔，默认已含 avatarsdk.com 及其子域）。
AVATARSDK_EXPORT_HOSTS=
# 2D 试穿（FASHN v1.6 on fal.ai）：有 FAL_KEY 即启用；TRYON_PROVIDER 可留空，设置时必须为 fashn_fal。没有 key 时不显示试穿入口。
TRYON_PROVIDER=
# 私有文件存储（照片与 3D 形象）：两项都填才启用 Supabase Storage 私有桶 avatar-private，否则存本地 .data/uploads/。
# service role key 只在服务端使用，绝不能加 NEXT_PUBLIC_ 前缀。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
