# 复制为 .env.local 后填写；.env.local 不进仓库。
# 不填时“一句话改编”使用标注为“非 AI”的规则模式。
ANTHROPIC_API_KEY=
# Better Auth 会话签名密钥，至少 32 位随机字符串：openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Supabase Postgres 连接串（Project Settings → Database）。不填则用本地 PGlite。
# 应用运行走 transaction pooler（6543 端口）；建表迁移走 session 模式或 5432 端口。
DATABASE_URL=
DATABASE_MIGRATE_URL=
