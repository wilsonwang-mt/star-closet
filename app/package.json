{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/setup-db.ts",
    "avatar:purge": "tsx --env-file-if-exists=.env.local scripts/purge-avatars.ts",
    "test": "tsx --test lib/avatar/*.test.ts lib/adapt/*.test.ts lib/tryon/*.test.ts lib/scene/*.test.ts lib/locate/*.test.ts lib/bag/*.test.ts lib/chat/*.test.ts",
    "fonts:build": "python3 scripts/build-fonts.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@electric-sql/pglite": "^0.5.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.3.0",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
